{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CLARITY",
  "version": "0.2.1",
  "identifier": "studio.enquso.clarity",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:6420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CLARITY",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true,
        "dragDropEnabled": false,
        "windowEffects": {
          "effects": [
            "mica"
          ]
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: asset: http://asset.localhost thumb: http://thumb.localhost; media-src 'self' blob: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost https://nexus.cloud.jonasbl.de asset: http://asset.localhost; worker-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [],
          "deny": []
        }
      }
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "copyright": "enquso",
    "category": "Utility",
    "shortDescription": "Understand your storage. Decide what stays. Reclaim your space.",
    "longDescription": "CLARITY analyses your drives locally, explains what takes up space, finds verified duplicates and lets you review and clean up safely via the Recycle Bin.",
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXkgRkZGNTU3ODM1QTA3QTBFOApSV1Rvb0FkYWcxZjEvd1NSWFd0MDVsUDFWVmRMT0NrVmJ5TmtJTzhuWVFCeXdKM29HZ3pkNngvRwo=",
      "endpoints": [
        "https://nexus.cloud.jonasbl.de/api/v1/compat/tauri/aevar/clarity/stable/{{target}}/{{arch}}/{{current_version}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}